{
    "compilerOptions": {
        "target": "esnext",
        "module": "esnext",
        "moduleResolution": "bundler",
        "checkJs": true,
        "noEmit": true,
        "jsx": "preserve",
        "sourceMap": true,
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "lib": ["esnext", "dom"],
        "types": ["vite/client"]
    },
    "include": ["src/js/**/*.js", "src/**/*.js", "src/**/*.jsx"]
}
